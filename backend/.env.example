# Application Settings
APP_NAME="Loom API"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY="your-super-secret-key-here"
ALLOWED_HOSTS=["*"]

# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://loom:loom@localhost:5432/loom"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# GitHub Configuration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:8000/api/v1/auth/github/callback"
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# AI Provider Configuration
# Options: openai, anthropic, loom-cloud, openrouter, gemini
AI_PROVIDER="openrouter"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LOOM_CLOUD_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_API_KEY=""
APP_URL="http://localhost:8081"

# Model Settings (OpenRouter slugs)
# Paid Recommendations:
# DEFAULT_MODEL="anthropic/claude-3.5-sonnet"
# AGENT_MODEL="openai/gpt-4o-mini"

# Free Recommendations:
DEFAULT_MODEL="cohere/north-mini-code:free"
AGENT_MODEL="google/gemma-2-9b-it:free"

# Task-Specific Models (Optional overrides)
MODEL_REPO_ANALYSIS="nvidia/nemotron-3-ultra:free"
MODEL_PLANNING="cohere/north-mini-code:free"
MODEL_IMPLEMENTATION="cohere/north-mini-code:free"
MODEL_CODE_REVIEW="google/gemma-2-9b-it:free"
